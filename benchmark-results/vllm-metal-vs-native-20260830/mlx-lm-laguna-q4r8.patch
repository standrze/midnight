+    def sanitize(self, weights):
+        """Load the native runner's exact Laguna Q4R8 storage layout.
+
+        The Swift checkpoint wraps text weights in ``language_model`` and
+        stores gate/up projections concatenated along the output dimension.
+        MLX-LM uses the unwrapped namespace and separate projections. Slicing
+        here creates MLX views; it does not requantize or alter tensor values.
+        """
+        sanitized = {}
+        wrapper = "language_model."
+        fused = ".gate_up_proj."
+        for key, value in weights.items():
+            if key.startswith(wrapper):
+                key = key[len(wrapper) :]
+            if fused not in key:
+                sanitized[key] = value
+                continue
 
+            output_size = value.shape[-2]
+            if output_size % 2:
+                raise ValueError(f"Odd fused gate/up output dimension for {key}")
+            midpoint = output_size // 2
+            sanitized[key.replace(fused, ".gate_proj.")] = value[..., :midpoint, :]
+            sanitized[key.replace(fused, ".up_proj.")] = value[..., midpoint:, :]
+        return sanitized
+
     @property
     def layers(self):
         return self.model.layers
