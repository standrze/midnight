+void timed_commit(
+    MTL::CommandBuffer* buffer,
+    uint64_t queue_key,
+    int operations,
+    uint64_t referenced_bytes) {
+  auto* collector = command_timing::collector();
+  auto* sample = collector
+      ? collector->reserve(queue_key, operations, referenced_bytes)
+      : nullptr;
+  if (!sample) {
+    buffer->commit();
+    return;
+  }
+  // Leave the native completion/error/event handler untouched. No ordering
+  // between handlers is assumed; this observer never signals events or waits.
+  buffer->addCompletedHandler([sample](MTL::CommandBuffer* completed) noexcept {
+    sample->row.callback_observed = command_timing::now();
+    sample->row.gpu_start = completed->GPUStartTime();
+    sample->row.gpu_end = completed->GPUEndTime();
+    sample->row.status = static_cast<int>(completed->status());
+    sample->completed.store(true, std::memory_order_release);
+  });
+  sample->row.commit_start = command_timing::now();
+  buffer->commit();
+  sample->row.commit_return = command_timing::now();
+  sample->returned.store(true, std::memory_order_release);
+}
+
+void timed_existing_wait(MTL::CommandBuffer* buffer, uint64_t queue_key) {
+  auto* collector = command_timing::collector();
+  if (!collector) {
+    buffer->waitUntilCompleted();
+    return;
+  }
+  const double start = command_timing::now();
+  buffer->waitUntilCompleted();
+  collector->record_wait(queue_key, start, command_timing::now());
+}
