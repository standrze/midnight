+import MLX
+
+/// A chronological sliding-window cache with an absolute token offset.
+///
+/// Each update presents the previous `window - 1` rows and every new row to
+/// attention, then retains an owned copy of the final window. Unlike a ring,
+/// the returned arrays and their causal mask always have chronological order.
+/// Temporary attention storage is at most `window - 1 + chunkLength` rows.
+/// This correctness-first cache copies O(window) rows on each decode step.
+public final class WindowedKVCache: BaseKVCache {
+    public let window: Int
+    private var keys: MLXArray?
+    private var values: MLXArray?
+
+    public init(window: Int) {
+        precondition(window > 0)
+        self.window = window
+        super.init()
+    }
+
+    public override var maxSize: Int? { window }
+
+    public override func innerState() -> [MLXArray] {
+        [keys, values].compactMap { $0 }
+    }
+
+    public override func update(keys: MLXArray, values: MLXArray) -> (MLXArray, MLXArray) {
+        precondition(keys.ndim == 4 && values.ndim == 4 && keys.dim(2) == values.dim(2))
+        let count = keys.dim(2)
+        precondition(count > 0)
+        let previous = min(offset, window - 1)
+        let workingKeys: MLXArray
+        let workingValues: MLXArray
+        let ownsConcatenatedStorage: Bool
+        if previous > 0, let oldKeys = self.keys, let oldValues = self.values {
+            let first = oldKeys.dim(2) - previous
+            workingKeys = concatenated([oldKeys[.ellipsis, first..., 0...], keys], axis: 2)
+            workingValues = concatenated([oldValues[.ellipsis, first..., 0...], values], axis: 2)
+            ownsConcatenatedStorage = true
+        } else {
+            workingKeys = keys
+            workingValues = values
+            ownsConcatenatedStorage = false
+        }
+        offset += count
+        let firstRetained = max(0, workingKeys.dim(2) - window)
+        if ownsConcatenatedStorage && firstRetained == 0 {
+            // Pinned MLX's two-input concat allocates its complete output on
+            // CPU and Metal. It already owns at most window rows. A separate
+            // array wrapper protects storage from mutation of the return value.
+            self.keys = workingKeys[.ellipsis]
+            self.values = workingValues[.ellipsis]
+        } else {
+            // Input arrays may be views; a cropped concat may own a much larger
+            // prefill allocation. Gather materializes only the retained rows.
+            let rows = MLXArray(Int32(firstRetained)..<Int32(workingKeys.dim(2)))
+            self.keys = take(workingKeys, rows, axis: 2).contiguous()
+            self.values = take(workingValues, rows, axis: 2).contiguous()
+        }
+        return (workingKeys, workingValues)
+    }
+
+    public override func makeMask(
+        n: Int, windowSize: Int?, returnArray: Bool
+    ) -> MLXFast.ScaledDotProductAttentionMaskMode {
+        let previous = min(offset, window - 1)
+        let effectiveWindow = min(windowSize ?? window, window)
+        if returnArray || previous + n > effectiveWindow {
+            return .array(createCausalMask(n: n, offset: previous, windowSize: effectiveWindow))
+        }
+        return n == 1 ? .none : .causal
+    }
+
+    public override var state: [MLXArray] {
+        get { innerState().map { $0[.ellipsis] } }
+        set {
+            precondition(newValue.isEmpty || Self.validState(newValue, window: window))
+            keys = newValue.first.map { $0[.ellipsis] }
+            values = newValue.last.map { $0[.ellipsis] }
+            offset = newValue.first?.dim(2) ?? 0
+        }
+    }
+
+    public override var metaState: [String] {
+        get { [String(window), String(offset)] }
+        set {
+            precondition(newValue.count == 2 && Int(newValue[0]) == window)
+            guard let absoluteOffset = Int(newValue[1]), absoluteOffset >= 0 else {
+                preconditionFailure("WindowedKVCache requires a nonnegative absolute offset")
+            }
+            precondition((keys?.dim(2) ?? 0) == min(absoluteOffset, window))
+            offset = absoluteOffset
+        }
+    }
+
+    public override var isTrimmable: Bool { offset <= window }
+
+    public override func isTrimmable(after positions: Int) -> Bool {
+        positions >= 0 && positions <= max(0, window - offset) && isTrimmable
+    }
+
+    @discardableResult
+    public override func trim(_ n: Int) -> Int {
+        // Once history has been evicted, a trim cannot recover its rows.
+        // Exact rollback uses copy/restore, never a false offset-only rewind.
+        guard n > 0, isTrimmable else { return 0 }
+        let trimmed = min(n, offset)
+        offset -= trimmed
+        if offset == 0 {
+            keys = nil
+            values = nil
+        } else {
+            keys = keys?[.ellipsis, ..<offset, 0...]
+            values = values?[.ellipsis, ..<offset, 0...]
+        }
+        return trimmed
+    }
+
+    public override func copy() -> any KVCache {
+        let result = WindowedKVCache(window: window)
+        result.state = state
+        result.metaState = metaState
+        return result
+    }
+
+    static func validState(_ state: [MLXArray], window: Int) -> Bool {
+        state.count == 2 && state.allSatisfy { $0.ndim == 4 && $0.dim(2) <= window }
+            && state[0].shape.prefix(3) == state[1].shape.prefix(3)
+    }
+}
