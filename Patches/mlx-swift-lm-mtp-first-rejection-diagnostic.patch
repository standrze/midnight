+    /// Emit one opt-in record for the first normal draft/verifier rejection.
+    /// This is not an A/B output divergence; it identifies the exact round and
+    /// confidence margin to correlate with a separate target-only comparison.
+    private mutating func reportFirstRejection(
+        accepted: Int,
+        proposed: Int,
+        queryOffset: Int,
+        draftToken: Int,
+        targetToken: Int,
+        logits: MLXArray
+    ) {
+        guard mtpFirstRejectionDiagnosticEnabled, !didReportFirstRejection else { return }
+        didReportFirstRejection = true
+        let topTwo = top(logits.asType(.float32), k: 2, axis: -1).flattened()
+        eval(topTwo)
+        let values = topTwo.asArray(Float.self)
+        let margin = values.count == 2 ? abs(values[0] - values[1]) : .nan
+        print(
+            "[MTP_FIRST_REJECTION] round=\(telemetry.roundCount + 1) "
+                + "generated_index=\(tokenCount + accepted) "
+                + "verify_cache_position=\(queryOffset + accepted) "
+                + "predicted_position=\(queryOffset + accepted + 1) "
+                + "accepted_prefix=\(accepted)/\(proposed) "
+                + "draft_token=\(draftToken) target_token=\(targetToken) "
+                + "top2_margin=\(margin)"
+        )
     }
 
