+
+private final class HarmonyIncrementalProbe: @unchecked Sendable {
+    var factoryCalls = 0
+    var batchDecodeCalls = 0
+    var appendedPieces: [String] = []
+    var skipSpecialTokens: [Bool] = []
+}
+
+private final class HarmonyFrameIncrementalDecoder: IncrementalTokenDecoder, @unchecked Sendable {
+    let idToToken: [Int: String]
+    let probe: HarmonyIncrementalProbe
+    var hasAppendedPayload = false
+
+    init(idToToken: [Int: String], probe: HarmonyIncrementalProbe) {
+        self.idToToken = idToToken
+        self.probe = probe
+    }
+
+    func append(token: Int) -> String? {
+        guard let piece = idToToken[token] else { return "" }
+        probe.appendedPieces.append(piece)
+        defer { hasAppendedPayload = true }
+        return hasAppendedPayload ? "decoder-state-leaked\(piece)" : piece
+    }
+}
+
+private struct HarmonyIncrementalTokenizer: Tokenizer, IncrementalTokenDecoderProviding {
+    private let tokenToID: [String: Int]
+    private let idToToken: [Int: String]
+    let probe: HarmonyIncrementalProbe
+
+    init(tokens: [String], probe: HarmonyIncrementalProbe) {
+        var tokenToID: [String: Int] = [:]
+        var idToToken: [Int: String] = [:]
+        var nextID = 0
+        for token in tokens where tokenToID[token] == nil {
+            tokenToID[token] = nextID
+            idToToken[nextID] = token
+            nextID += 1
+        }
+        self.tokenToID = tokenToID
+        self.idToToken = idToToken
+        self.probe = probe
+    }
+
+    func encode(text: String, addSpecialTokens: Bool) -> [Int] {
+        tokenToID[text].map { [$0] } ?? []
+    }
+
+    func decode(tokenIds: [Int], skipSpecialTokens: Bool) -> String {
+        probe.batchDecodeCalls += 1
+        return tokenIds.compactMap { idToToken[$0] }.joined()
+    }
+
+    func convertTokenToId(_ token: String) -> Int? { tokenToID[token] }
+    func convertIdToToken(_ id: Int) -> String? { idToToken[id] }
+    var bosToken: String? { nil }
+    var eosToken: String? { nil }
+    var unknownToken: String? { nil }
+
+    func applyChatTemplate(
+        messages: [[String: any Sendable]],
+        tools: [[String: any Sendable]]?,
+        additionalContext: [String: any Sendable]?
+    ) throws -> [Int] { [] }
+
+    func makeIncrementalTokenDecoder(
+        skipSpecialTokens: Bool
+    ) -> (any IncrementalTokenDecoder)? {
+        probe.factoryCalls += 1
+        probe.skipSpecialTokens.append(skipSpecialTokens)
+        return HarmonyFrameIncrementalDecoder(idToToken: idToToken, probe: probe)
+    }
+}
