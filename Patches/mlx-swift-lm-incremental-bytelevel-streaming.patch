+    @Test("incremental payload decoders are used and reset between Harmony frames")
+    func incrementalPayloadDecodersResetBetweenFrames() throws {
+        let pieces = [
+            "<|channel|>", "analysis", "<|message|>", "reason-one", "<|end|>",
+            "<|channel|>", "analysis", "<|message|>", "reason-two", "<|end|>",
+            "<|channel|>", "final", "<|message|>", "public-one", "<|end|>",
+            "<|channel|>", "final", "<|message|>", "public-two", "<|return|>",
+        ]
+        let probe = HarmonyIncrementalProbe()
+        let tokenizer = HarmonyIncrementalTokenizer(
+            tokens: pieces + routerControlTokens,
+            probe: probe)
+        var parser = try #require(HarmonyFrameParser(tokenizer: tokenizer))
+        var router = HarmonyOutputRouter(tokenizer: tokenizer, allowedToolNames: nil)
+        var events: [HarmonyOutputRouter.Event] = []
+
+        for piece in pieces {
+            let id = try #require(tokenizer.convertTokenToId(piece))
+            for step in parser.push(id) {
+                events.append(contentsOf: router.route(step))
+            }
+        }
+        for step in parser.finish() {
+            events.append(contentsOf: router.route(step))
+        }
+        events.append(contentsOf: router.finish())
+
+        let reasoning = events.compactMap(\.reasoning).joined()
+        let response = events.compactMap(\.response).joined()
+        #expect(reasoning == "reason-onereason-two")
+        #expect(response == "public-onepublic-two")
+        #expect(!reasoning.contains("decoder-state-leaked"))
+        #expect(!response.contains("decoder-state-leaked"))
+        #expect(probe.factoryCalls == 6)
+        #expect(probe.batchDecodeCalls == 4)
+        #expect(probe.appendedPieces == ["reason-one", "reason-two", "public-one", "public-two"])
+        #expect(probe.skipSpecialTokens == Array(repeating: false, count: 6))
+    }
 }

