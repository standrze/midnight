new file mode 100644
--- /dev/null
+++ b/Libraries/MLXLMCommon/MTPAdaptiveDraftPolicy.swift
@@ -0,0 +1,68 @@
+/// An experimental, per-stream policy that chooses a bounded draft count from
+/// measured useful tokens per second. Public only for deterministic regression tests.
+@_spi(Testing) public struct MTPAdaptiveDraftPolicy {
+    public private(set) var nextDraftCount: Int
+
+    private let candidates: [Int]
+    private var warmed: [Bool]
+    private var tokensPerSecond: [Double?]
+    private var roundsUntilProbe = 8
+    private var probeIndex = 0
+
+    /// Public block size remains the upper bound; this experiment verifies at
+    /// most eight positions. Sparse candidates limit shape compilation overhead.
+    public init(maximumBlockSize: Int) {
+        precondition(maximumBlockSize >= 2)
+        let maximumDrafts = min(maximumBlockSize, 8) - 1
+        candidates = Array(Set([1, 3, 7, maximumDrafts].filter { $0 <= maximumDrafts })).sorted()
+        nextDraftCount = candidates[0]
+        warmed = Array(repeating: false, count: candidates.count)
+        tokensPerSecond = Array(repeating: nil, count: candidates.count)
+    }
+
+    /// Observe one completed greedy verification. Budget-clipped tails and
+    /// invalid timings do not train or advance the policy. The first round at
+    /// each width warms that graph without treating compilation as steady cost.
+    public mutating func observe(drafted: Int, accepted: Int, elapsedSeconds: Double) {
+        guard drafted == nextDraftCount,
+            accepted >= 0, accepted <= drafted,
+            elapsedSeconds.isFinite, elapsedSeconds > 0,
+            let index = candidates.firstIndex(of: drafted)
+        else { return }
+
+        if !warmed[index] {
+            warmed[index] = true
+            return
+        }
+
+        let rate = Double(accepted + 1) / elapsedSeconds
+        guard rate.isFinite else { return }
+        if let previous = tokensPerSecond[index] {
+            tokensPerSecond[index] = previous * 0.75 + rate * 0.25
+        } else {
+            tokensPerSecond[index] = rate
+        }
+
+        if let unmeasured = tokensPerSecond.firstIndex(where: { $0 == nil }) {
+            nextDraftCount = candidates[unmeasured]
+            return
+        }
+
+        // Revisit widths periodically as context and acceptance change. Stable
+        // ties choose the smaller width; no random numbers influence policy.
+        roundsUntilProbe -= 1
+        if roundsUntilProbe == 0 {
+            nextDraftCount = candidates[probeIndex]
+            probeIndex = (probeIndex + 1) % candidates.count
+            roundsUntilProbe = 8
+        } else {
+            var best = 0
+            for candidate in candidates.indices.dropFirst() {
+                if tokensPerSecond[candidate]! > tokensPerSecond[best]! {
+                    best = candidate
+                }
+            }
+            nextDraftCount = candidates[best]
+        }
+    }
+}
