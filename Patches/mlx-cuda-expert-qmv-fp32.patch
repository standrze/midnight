+  encoder.set_input_array(scales);
+  encoder.set_input_array(biases);
+  encoder.set_input_array(lhs_indices);
+  encoder.set_input_array(rhs_indices);
+  encoder.set_output_array(out);
+  int n = out.shape(-1);
+  const int k = x.shape(-1);
+  dispatch_element_types(out.dtype(), "[midnight_expert_qmv]", [&]<typename T>() {
+    auto launch = [&]<int K>() {
+      auto* kernel = &cu::midnight_expert_qmv_fp32_kernel<T, K>;
+      const T* input = gpu_ptr<T>(x);
+      const uint32_t* weights = gpu_ptr<uint32_t>(w);
+      const T* scale = gpu_ptr<T>(scales);
+      const T* bias = gpu_ptr<T>(biases);
+      const uint32_t* lhs = gpu_ptr<uint32_t>(lhs_indices);
+      const uint32_t* rhs = gpu_ptr<uint32_t>(rhs_indices);
+      T* output = gpu_ptr<T>(out);
+      void* args[] = {&input, &weights, &scale, &bias, &lhs, &rhs, &output,
+                      &n};
+      encoder.add_kernel_node_raw(
+          reinterpret_cast<void*>(kernel), dim3(n / 4, 8), dim3(32, 4), {}, 0, args);
+    };
