     @TaskLocal static var defaultStream: Stream?
 
+    /// Use an existing stream as ``StreamOrDevice/default`` for the duration of `body`.
+    public static func withDefaultStream<R>(
+        _ existing: Stream, body: () throws -> R
+    ) rethrows -> R {
+        try $defaultStream.withValue(existing, operation: body)
+    }
+
+    /// Use an existing stream as ``StreamOrDevice/default`` for the duration of `body`.
+    ///
+    /// Child tasks inherit the task-local stream. The caller remains responsible for
+    /// serializing access when the same stream is shared across tasks.
+    public static func withDefaultStream<R>(
+        _ existing: Stream, body: () async throws -> R
+    ) async rethrows -> R {
+        try await $defaultStream.withValue(existing, operation: body)
+    }
+
     /// Set the ``StreamOrDevice/default`` scoped to a Task.
