+import Cmlx
+
+extension MLXFast {
+    /// Errors detected before a custom CUDA kernel is evaluated.
+    public enum CUDAKernelError: Error, Equatable, Sendable {
+        case unavailable
+        case invalidConfiguration(String)
+        case operationFailed(String)
+    }
+
+    /// Whether this MLX runtime has a usable CUDA backend.
+    ///
+    /// This is false on Metal. It does not change the default device. Linux builds with
+    /// `SPM_CUDA=0` exclude the entire MLXFast API, including this binding.
+    public static var isCUDAKernelAvailable: Bool {
+        (try? withError {
+            var available = false
+            guard mlx_cuda_is_available(&available) == 0, available else {
+                return false
+            }
+            // The CUDA backend probe reports compilation support even when no
+            // NVIDIA device is visible. Query devices before constructing a stream.
+            var count: Int32 = 0
+            return mlx_device_count(&count, MLX_GPU) == 0 && count > 0
+        }) ?? false
+    }
+
+    /// Create a custom CUDA kernel from a function body and optional header.
+    ///
+    /// MLX generates the signature from the named inputs and outputs. Compilation and
+    /// execution remain lazy: wrap evaluation in `withError` to catch NVRTC or GPU errors.
+    /// `sharedMemory` is the number of dynamic shared-memory bytes per thread block.
+    /// Throws `CUDAKernelError.unavailable` when the CUDA backend is unavailable.
+    public static func cudaKernel(
+        name: String,
+        inputNames: some Sequence<String>,
+        outputNames: some Sequence<String>,
+        source: String,
+        header: String = "",
+        ensureRowContiguous: Bool = true,
+        sharedMemory: Int = 0
+    ) throws -> CUDAKernel {
+        try CUDAKernel(
+            name: name, inputNames: Array(inputNames), outputNames: Array(outputNames),
+            source: source, header: header, ensureRowContiguous: ensureRowContiguous,
+            sharedMemory: sharedMemory)
+    }
+
+    /// A reusable CUDA kernel. Each call builds an independent launch configuration.
+    ///
+    /// Like other MLX operations, returned arrays are lazy. The caller remains responsible
+    /// for stream synchronization, source correctness, and bounds checks inside the kernel.
+    public final class CUDAKernel: @unchecked Sendable {
+        private let kernel: mlx_fast_cuda_kernel
+        private let inputCount: Int
+        public let outputNames: [String]
+
+        fileprivate init(
+            name: String, inputNames: [String], outputNames: [String],
+            source: String, header: String, ensureRowContiguous: Bool, sharedMemory: Int
+        ) throws {
+            guard !outputNames.isEmpty else {
+                throw CUDAKernelError.invalidConfiguration("At least one output is required.")
+            }
+            guard sharedMemory >= 0, let sharedBytes = Int32(exactly: sharedMemory) else {
+                throw CUDAKernelError.invalidConfiguration("sharedMemory must fit a nonnegative Int32.")
+            }
+            guard !name.isEmpty,
+                !inputNames.contains(where: { $0.isEmpty }),
+                !outputNames.contains(where: { $0.isEmpty }),
+                !([name, source, header] + inputNames + outputNames).contains(where: { $0.utf8.contains(0) })
+            else {
+                throw CUDAKernelError.invalidConfiguration("Names must be nonempty; strings cannot contain NUL.")
+            }
+            guard Set(inputNames + outputNames).count == inputNames.count + outputNames.count else {
+                throw CUDAKernelError.invalidConfiguration("Input and output names must be unique.")
+            }
+            guard MLXFast.isCUDAKernelAvailable else {
+                throw CUDAKernelError.unavailable
+            }
+
+            self.inputCount = inputNames.count
+            self.outputNames = outputNames
+            self.kernel = try withError { error in
+                let inputs = mlx_vector_string_new()
+                defer { mlx_vector_string_free(inputs) }
+                let outputs = mlx_vector_string_new()
+                defer { mlx_vector_string_free(outputs) }
+                try error.check()
+                for value in inputNames {
+                    try Self.check(mlx_vector_string_append_value(inputs, value), error, "adding input name")
+                }
+                for value in outputNames {
+                    try Self.check(mlx_vector_string_append_value(outputs, value), error, "adding output name")
+                }
+                let result = mlx_fast_cuda_kernel_new(
+                    name, inputs, outputs, source, header, ensureRowContiguous, sharedBytes)
+                try error.check()
+                guard result.ctx != nil else {
+                    throw CUDAKernelError.operationFailed("creating CUDA kernel")
+                }
+                return result
+            }
+        }
+
+        deinit {
+            mlx_fast_cuda_kernel_free(kernel)
+        }
+
+        /// Create lazy output arrays for a CUDA launch.
+        ///
+        /// `grid` counts threads, not CUDA blocks. MLX rounds each dimension up to a
+        /// multiple of `threadGroup`; source code must guard any excess threads.
+        /// Template arguments support `Bool`, `Int` (within Int32), and `DType`.
+        /// `stream` must belong to a GPU; a CPU stream throws before dispatch.
+        public func callAsFunction(
+            _ inputs: [any ScalarOrArray],
+            template: [(String, any KernelTemplateArg)]? = nil,
+            grid: (Int, Int, Int),
+            threadGroup: (Int, Int, Int),
+            outputShapes: some Sequence<[Int]>,
+            outputDTypes: some Sequence<DType>,
+            initValue: Float? = nil,
+            verbose: Bool = false,
+            stream: StreamOrDevice = .default
+        ) throws -> [MLXArray] {
+            let shapes = Array(outputShapes)
+            let dtypes = Array(outputDTypes)
+            guard inputs.count == inputCount,
+                shapes.count == outputNames.count, dtypes.count == outputNames.count
+            else {
+                throw CUDAKernelError.invalidConfiguration("Input, output shape, or output dtype count does not match.")
+            }
+            let grid = try Self.dimensions(grid, name: "grid")
+            let group = try Self.dimensions(threadGroup, name: "threadGroup")
+            var threads = 1
+            for (size, block) in zip(grid, group) {
+                guard Int64(size) + Int64(block) - 1 <= Int64(Int32.max),
+                    Int(block) <= 1024 / threads
+                else {
+                    throw CUDAKernelError.invalidConfiguration(
+                        "Launch dimensions overflow or exceed 1024 threads per block.")
+                }
+                threads *= Int(block)
+            }
+            let shapeDimensions = try shapes.map { shape in
+                try shape.map { value -> Int32 in
+                    guard value >= 0, let dimension = Int32(exactly: value) else {
+                        throw CUDAKernelError.invalidConfiguration("Output dimensions must fit a nonnegative Int32.")
+                    }
+                    return dimension
+                }
+            }
+
+            return try withError { error in
+                var device = mlx_device_new()
+                defer { mlx_device_free(device) }
+                try Self.check(mlx_stream_get_device(&device, stream.ctx), error, "reading stream device")
+                var deviceType = MLX_CPU
+                try Self.check(mlx_device_get_type(&deviceType, device), error, "reading device type")
+                guard deviceType == MLX_GPU else {
+                    throw CUDAKernelError.invalidConfiguration("CUDA kernels require a GPU stream.")
+                }
+
+                let config = mlx_fast_cuda_kernel_config_new()
+                defer { mlx_fast_cuda_kernel_config_free(config) }
+                try error.check()
+                for (name, argument) in template ?? [] {
+                    guard !name.isEmpty, !name.utf8.contains(0) else {
+                        throw CUDAKernelError.invalidConfiguration(
+                            "Template names must be nonempty and cannot contain NUL.")
+                    }
+                    let status: Int32
+                    switch argument {
+                    case let value as Bool:
+                        status = mlx_fast_cuda_kernel_config_add_template_arg_bool(config, name, value)
+                    case let value as Int:
+                        guard let value = Int32(exactly: value) else {
+                            throw CUDAKernelError.invalidConfiguration("Integer template arguments must fit Int32.")
+                        }
+                        status = mlx_fast_cuda_kernel_config_add_template_arg_int(config, name, value)
+                    case let value as DType:
+                        status = mlx_fast_cuda_kernel_config_add_template_arg_dtype(config, name, value.cmlxDtype)
+                    default:
+                        throw CUDAKernelError.invalidConfiguration("Unsupported template argument: \(name).")
+                    }
+                    try Self.check(status, error, "adding template argument")
+                }
+                try Self.check(
+                    mlx_fast_cuda_kernel_config_set_grid(config, grid[0], grid[1], grid[2]), error, "setting grid")
+                try Self.check(
+                    mlx_fast_cuda_kernel_config_set_thread_group(config, group[0], group[1], group[2]),
+                    error, "setting thread group")
+                for (shape, dtype) in zip(shapeDimensions, dtypes) {
+                    try Self.check(
+                        mlx_fast_cuda_kernel_config_add_output_arg(config, shape, shape.count, dtype.cmlxDtype),
+                        error, "adding output")
+                }
+                if let initValue {
+                    try Self.check(
+                        mlx_fast_cuda_kernel_config_set_init_value(config, initValue), error, "setting initial value")
+                }
+                try Self.check(
+                    mlx_fast_cuda_kernel_config_set_verbose(config, verbose), error, "setting verbosity")
+                let inputArrays = new_mlx_vector_array(inputs.map { $0.asMLXArray(dtype: nil) })
+                defer { mlx_vector_array_free(inputArrays) }
+                var result = mlx_vector_array_new()
+                defer { mlx_vector_array_free(result) }
+                try error.check()
+                try Self.check(
+                    mlx_fast_cuda_kernel_apply(&result, kernel, inputArrays, config, stream.ctx),
+                    error, "applying CUDA kernel")
+                return mlx_vector_array_values(result)
+            }
+        }
+
+        private static func check(_ status: Int32, _ error: ErrorBox, _ operation: String) throws {
+            try error.check()
+            guard status == 0 else {
+                throw CUDAKernelError.operationFailed(operation)
+            }
+        }
+
+        private static func dimensions(_ value: (Int, Int, Int), name: String) throws -> [Int32] {
+            try [value.0, value.1, value.2].map { value in
+                guard value > 0, let dimension = Int32(exactly: value) else {
+                    throw CUDAKernelError.invalidConfiguration("\(name) dimensions must fit a positive Int32.")
+                }
+                return dimension
+            }
+        }
+    }
+}
