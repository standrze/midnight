diff --git a/Libraries/MLXLMCommon/MLXTaskExecutorPreference.swift b/Libraries/MLXLMCommon/MLXTaskExecutorPreference.swift
new file mode 100644
index 0000000..cc0dc56
--- /dev/null
+++ b/Libraries/MLXLMCommon/MLXTaskExecutorPreference.swift
@@ -0,0 +1,10 @@
+// Copyright © 2026 Apple Inc.
+
+/// Task-scoped executor used by MLX generation's unstructured producer tasks.
+///
+/// Set the projected task-local value around model work. Both `ChatSession` and
+/// the low-level token loop explicitly pass the inherited preference to the
+/// unstructured tasks they create.
+public enum MLXTaskExecutorPreference {
+    @TaskLocal public static var current: (any TaskExecutor)?
+}
