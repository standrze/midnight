+    /// Capture an independently reusable in-memory checkpoint of this session.
+    ///
+    /// The main and optional draft caches are copied together with model state, structured
+    /// messages, and the exact cached/uncommitted token ledger. Restore with
+    /// ``init(_:restoring:speculativeDecoding:generateParameters:components:processing:additionalContext:tools:toolDispatch:)``.
+    ///
+    /// - Throws: ``ChatSessionError/noCacheAvailable`` before the first successful generation.
+    public func snapshot() async throws -> ChatSessionSnapshot {
+        let instructions = self.instructions
+        return try await cache.read { cache in
+            guard case .kvcache(let stored) = cache else {
+                throw ChatSessionError.noCacheAvailable
+            }
+            let mainCopy = stored.main.copy()
+            let draftCopy = stored.draft?.copy()
+            let copiedArrays =
+                mainCopy.cache.flatMap(\.state) + (draftCopy?.cache.flatMap(\.state) ?? [])
+            if !copiedArrays.isEmpty {
+                eval(copiedArrays)
+            }
+            return ChatSessionSnapshot(
+                main: mainCopy,
+                draft: draftCopy,
+                state: stored.state,
+                messages: stored.conversation?.messages,
+                cachedTokens: stored.conversation?.cachedTokens,
+                uncommittedTokens: stored.conversation?.uncommittedTokens,
+                instructions: instructions)
+        }
+    }
