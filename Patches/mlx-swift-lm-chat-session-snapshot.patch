+/// An immutable, reusable checkpoint of a ``ChatSession``.
+///
+/// Unlike ``PromptCacheSnapshot``, this also retains the structured conversation and exact
+/// token ledger used to reconcile a re-rendered chat template. That makes it suitable for
+/// branching several sessions from the same completed conversation prefix. Every restored
+/// session receives independent cache instances.
+///
+/// Model-state values are copied with Swift value semantics and must be immutable. MLX arrays
+/// satisfy that contract; callers adding reference-typed state must provide their own snapshot
+/// boundary before exposing this API for that model.
+public struct ChatSessionSnapshot: @unchecked Sendable {
+    fileprivate let main: KVCacheStorage
+    fileprivate let draft: KVCacheStorage?
+    fileprivate let state: LMOutput.State?
+    fileprivate let messages: [Chat.Message]?
+    fileprivate let cachedTokens: [Int]?
+    fileprivate let uncommittedTokens: [Int]?
+    fileprivate let instructions: String?
+
+    /// Approximate bytes occupied by the copied main and draft cache arrays.
+    ///
+    /// This is a conservative accounting value for bounded in-memory caches. Views can share
+    /// backing storage internally, so it is not a process-resident-memory measurement.
+    public let estimatedBytes: Int
+
+    fileprivate init(
+        main: KVCacheStorage,
+        draft: KVCacheStorage?,
+        state: LMOutput.State?,
+        messages: [Chat.Message]?,
+        cachedTokens: [Int]?,
+        uncommittedTokens: [Int]?,
+        instructions: String?
+    ) {
+        self.main = main
+        self.draft = draft
+        self.state = state
+        self.messages = messages
+        self.cachedTokens = cachedTokens
+        self.uncommittedTokens = uncommittedTokens
+        self.instructions = instructions
+        self.estimatedBytes =
+            self.main.cache.flatMap(\.state).reduce(0) { $0 + $1.nbytes }
+            + (self.draft?.cache.flatMap(\.state).reduce(0) { $0 + $1.nbytes } ?? 0)
+    }
+}
