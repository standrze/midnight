+  static int enabled = env::get_var("MLX_METAL_AFFINE_Q4_QMV_TAIL", 0);
+  static const std::string scope =
+      env::get_var("MLX_METAL_AFFINE_Q4_QMV_TAIL_SCOPE", "all");
+  bool scope_matches = scope == "all" || scope == (gather ? "gather" : "dense");
+  return enabled == 1 && scope_matches && mode == "affine" &&
+      group_size == 64 && bits == 4 &&
+      (dtype == float16 || dtype == bfloat16) && N > 0 && N % 8 == 0 &&
+      K >= 512 && K % 64 == 0 && K % 512 != 0;
