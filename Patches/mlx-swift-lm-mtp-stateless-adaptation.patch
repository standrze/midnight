diff --git a/Libraries/MLXLMCommon/MTPStatelessLogitProcessor.swift b/Libraries/MLXLMCommon/MTPStatelessLogitProcessor.swift
new file mode 100644
--- /dev/null
+++ b/Libraries/MLXLMCommon/MTPStatelessLogitProcessor.swift
@@ -0,0 +1,9 @@
+/// A processor whose per-position result is independent of prompt and emitted-token history.
+///
+/// Conform only when `prompt` and `didSample` are no-ops and `process(logits:)`
+/// deterministically transforms each verifier position without mutable state.
+/// This permits opt-in adaptive MTP draft widths; it does not promise that
+/// processing a batch of positions is equivalent to processing each row alone.
+/// The iterator preserves row-wise processing, sampling and callback order.
+/// Stateful processors and processor chains must not adopt this marker.
+public protocol MTPStatelessLogitProcessor: LogitProcessor {}
