+    func testDirectSliceUpdatePreservesIdentityAndAvoidsShapeOperations() {
+        let a = MLXArray((0 ..< 20).asInt32, [2, 2, 5, 1])
+        let identity = ObjectIdentifier(a)
+        let cWrapperIdentity = a.ctx.ctx
+        let update = MLXArray((88 ..< 96).asInt32, [2, 2, 2, 1])
+
+        a.updateSliceAxis2(
+            with: update,
+            range: 2 ..< 4)
+
+        XCTAssertEqual(ObjectIdentifier(a), identity)
+        XCTAssertEqual(a.ctx.ctx, cWrapperIdentity)
+        let description = graphDescription([a])
+        XCTAssertTrue(description.contains("SliceUpdate"), "expected SliceUpdate in:\n\(description)")
+        XCTAssertFalse(description.contains("Broadcast"), "unexpected Broadcast in:\n\(description)")
+        XCTAssertFalse(description.contains("Reshape"), "unexpected Reshape in:\n\(description)")
+
+        let expected = MLXArray(
+            [0, 1, 88, 89, 4, 5, 6, 90, 91, 9, 10, 11, 92, 93, 14, 15, 16, 94, 95, 19]
+                .asInt32, [2, 2, 5, 1])
+        assertEqual(a, expected)
+    }
