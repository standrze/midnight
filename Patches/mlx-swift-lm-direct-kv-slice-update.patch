+@Test func testSimpleCacheDirectSliceUpdatePreservesIdentityUntilGrowth() {
+    let cache = KVCacheSimple()
+    cache.step = 2
+
+    let first = positionedKV(0 ..< 1)
+    _ = cache.update(keys: first.0, values: first.1)
+    let initial = cache.innerState()
+
+    let second = positionedKV(1 ..< 2)
+    let firstWindow = cache.update(keys: second.0, values: second.1)
+    let filled = cache.innerState()
+    #expect(initial[0] === filled[0])
+    #expect(initial[1] === filled[1])
+    #expect(encodedPositions(firstWindow.0) == [0, 1])
+
+    let third = positionedKV(2 ..< 3)
+    _ = cache.update(keys: third.0, values: third.1)
+    let grown = cache.innerState()
+    #expect(initial[0] !== grown[0], "capacity growth must install a larger key array")
+    #expect(initial[1] !== grown[1], "capacity growth must install a larger value array")
+
+    let fourth = positionedKV(3 ..< 4)
+    let fullWindow = cache.update(keys: fourth.0, values: fourth.1)
+    let refilled = cache.innerState()
+    #expect(grown[0] === refilled[0])
+    #expect(grown[1] === refilled[1])
+    #expect(encodedPositions(fullWindow.0) == [0, 1, 2, 3])
+    #expect(encodedPositions(fullWindow.1).map { -$0 } == [0, 1, 2, 3])
+}
+
+@Test func testRotatingCacheDirectSliceUpdatePreservesIdentityAcrossWrap() throws {
+    let cache = RotatingKVCache(maxSize: 4, keep: 0, step: 4)
+
+    let first = positionedKV(0 ..< 1)
+    _ = cache.update(keys: first.0, values: first.1)
+    let storage = cache.innerState()
+
+    fillOneAtATime(cache, positions: 1 ..< 10)
+    let wrapped = cache.innerState()
+    #expect(storage[0] === wrapped[0])
+    #expect(storage[1] === wrapped[1])
+
+    let view = cache.logicalView(tail: 4)
+    #expect(encodedPositions(try #require(view).0) == [6, 7, 8, 9])
+    #expect(encodedPositions(try #require(view).1).map { -$0 } == [6, 7, 8, 9])
+}
+
 @Test func testRotatingLogicalViewIsNilBeforeFirstWrite() {
     #expect(RotatingKVCache(maxSize: 8, keep: 0).logicalView(tail: 8) == nil)
 }
