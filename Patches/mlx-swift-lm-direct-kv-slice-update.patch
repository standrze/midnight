+/// Write an exact `[B, H, range, D]` cache slice without constructing generic index operations.
+private func updateKVCacheSlice(
+    _ cache: MLXArray, with update: MLXArray, range: Range<Int>
+) {
+    cache.updateSliceAxis2(with: update, range: range)
+}
