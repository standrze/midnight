 import Foundation
 import Hub

+/// Stateful decoder for tokenizers whose output can be emitted incrementally
+/// without re-decoding the complete generated-token prefix.
+public protocol IncrementalTokenDecoder: Sendable {
+    /// Consumes one token ID and returns the stable text made available by it.
+    /// Returns `nil` while decoded text ends in a replacement character, which
+    /// may represent an incomplete UTF-8 scalar split across token boundaries.
+    mutating func append(token: Int) -> String?
+}
+
+/// Optional tokenizer capability for safe incremental decoding.
+public protocol IncrementalTokenDecoderProviding: Sendable {
+    func makeIncrementalTokenDecoder(skipSpecialTokens: Bool) -> (any IncrementalTokenDecoder)?
+}
+
+public extension IncrementalTokenDecoderProviding {
+    func makeIncrementalTokenDecoder() -> (any IncrementalTokenDecoder)? {
+        makeIncrementalTokenDecoder(skipSpecialTokens: false)
+    }
+}
+
+/// Immutable load-time lookup that removes vocabulary and byte-alphabet work
+/// from the generated-token loop.
+final class ByteLevelIncrementalDecodingTable: Sendable {
+    static let maximumDenseTokenID = 1_000_000
+    static let maximumDecodedByteCount = 32 * 1_024 * 1_024
+
+    struct Entry: Sendable {
+        static let missingLength: Int32 = -1
+        static let addedTokenLength: Int32 = -2
+
+        var offset: Int32
+        var length: Int32
+
+        static let missing = Entry(offset: 0, length: missingLength)
+        static let addedToken = Entry(offset: 0, length: addedTokenLength)
+    }
+
+    let entries: [Entry]
+    let bytes: [UTF8.CodeUnit]
+    let addedTokenLiterals: [Int: String]
+
+    init?(
+        model: any TokenizingModel,
+        tokenCount: Int,
+        addedTokens: Set<String>
+    ) {
+        guard
+            model is BPETokenizer,
+            tokenCount > 0,
+            tokenCount <= Self.maximumDenseTokenID + 1
+        else { return nil }
+
+        var entries = Array(repeating: Entry.missing, count: tokenCount)
+        var bytes: [UTF8.CodeUnit] = []
+        var literals: [Int: String] = [:]
+        bytes.reserveCapacity(tokenCount * 7)
+        literals.reserveCapacity(addedTokens.count)
+
+        for id in 0..<tokenCount {
+            guard let piece = model.convertIdToToken(id) else { continue }
+            if addedTokens.contains(piece) {
+                entries[id] = .addedToken
+                literals[id] = piece
+                continue
+            }
+
+            let offset = bytes.count
+            for character in piece {
+                guard let byte = byteDecoder[String(character)] else { return nil }
+                guard bytes.count < Self.maximumDecodedByteCount else { return nil }
+                bytes.append(byte)
+            }
+            guard offset <= Int(Int32.max), bytes.count - offset <= Int(Int32.max) else {
+                return nil
+            }
+            entries[id] = Entry(
+                offset: Int32(offset),
+                length: Int32(bytes.count - offset))
+        }
+
+        self.entries = entries
+        self.bytes = bytes
+        self.addedTokenLiterals = literals
+    }
+}
+
+/// Incremental form of an exact top-level ByteLevel decoder. It retains only
+/// the short run whose current lossy decode ends in U+FFFD; that matches the
+/// existing streaming detokenizer's incomplete-scalar suppression semantics.
+struct ByteLevelIncrementalTokenDecoder: IncrementalTokenDecoder {
+    private let table: ByteLevelIncrementalDecodingTable
+    private let skippedTokenIDs: Set<Int>
+    private var withheldText = ""
+    private var pendingBytes: [UTF8.CodeUnit] = []
+
+    init(
+        table: ByteLevelIncrementalDecodingTable,
+        skippedTokenIDs: Set<Int> = []
+    ) {
+        self.table = table
+        self.skippedTokenIDs = skippedTokenIDs
+        pendingBytes.reserveCapacity(8)
+    }
+
+    mutating func append(token: Int) -> String? {
+        // Filtering a special token removes it before decoder grouping, so it
+        // must not flush a partial ordinary-token byte sequence.
+        guard !skippedTokenIDs.contains(token) else { return unchangedOutput() }
+        guard token >= 0, token < table.entries.count else { return unchangedOutput() }
+
+        let entry = table.entries[token]
+        switch entry.length {
+        case ByteLevelIncrementalDecodingTable.Entry.missingLength:
+            return unchangedOutput()
+
+        case ByteLevelIncrementalDecodingTable.Entry.addedTokenLength:
+            guard let literal = table.addedTokenLiterals[token] else {
+                return unchangedOutput()
+            }
+            let decoded = String(decoding: pendingBytes, as: UTF8.self)
+            let prefix = withheldText.isEmpty ? decoded : withheldText + decoded
+            let text = prefix.isEmpty ? literal : prefix + literal
+            pendingBytes.removeAll(keepingCapacity: true)
+            return emitIfStable(text)
+
+        default:
+            let offset = Int(entry.offset)
+            let end = offset + Int(entry.length)
+            let bytes = table.bytes[offset..<end]
+            if pendingBytes.isEmpty, withheldText.isEmpty {
+                let text = String(decoding: bytes, as: UTF8.self)
+                guard text.last == "\u{fffd}" else { return text }
+                pendingBytes.append(contentsOf: bytes)
+                return nil
+            }
+
+            pendingBytes.append(contentsOf: bytes)
+            let decoded = String(decoding: pendingBytes, as: UTF8.self)
+            let text = withheldText.isEmpty ? decoded : withheldText + decoded
+            guard text.last != "\u{fffd}" else { return nil }
+            withheldText.removeAll(keepingCapacity: true)
+            pendingBytes.removeAll(keepingCapacity: true)
+            return text
+        }
+    }
+
+    private func unchangedOutput() -> String? {
+        withheldText.isEmpty && pendingBytes.isEmpty ? "" : nil
+    }
+
+    private mutating func emitIfStable(_ text: String) -> String? {
+        guard text.last != "\u{fffd}" else {
+            withheldText = text
+            return nil
+        }
+        withheldText.removeAll(keepingCapacity: true)
+        return text
+    }
+}
