+// Copyright © 2026 Hugging Face
+
+import Foundation
+import Hub
+import Testing
+
+@testable import Tokenizers
+
+@Suite("Incremental ByteLevel decoder")
+struct IncrementalByteLevelDecoderTests {
+    private struct AddedToken {
+        var id: Int
+        var content: String
+        var special: Bool
+    }
+
+    private func encoded(_ bytes: [UTF8.CodeUnit]) -> String {
+        bytes.map { byteEncoder[$0]! }.joined()
+    }
+
+    private func config(_ object: [String: Any]) throws -> Config {
+        let data = try JSONSerialization.data(withJSONObject: object)
+        return try JSONDecoder().decode(Config.self, from: data)
+    }
+
+    private func makeTokenizer(
+        _ pieces: [Int: String],
+        addedTokens: [AddedToken] = [],
+        cleanup: Bool? = false,
+        byteFallback: Bool? = false,
+        decoder: [String: Any]? = ["type": "ByteLevel"]
+    ) throws -> PreTrainedTokenizer {
+        var tokenizerConfig: [String: Any] = [
+            "tokenizer_class": "PreTrainedTokenizerFast"
+        ]
+        if let cleanup {
+            tokenizerConfig["clean_up_tokenization_spaces"] = cleanup
+        }
+
+        var model: [String: Any] = [
+            "type": "BPE",
+            "vocab": Dictionary(uniqueKeysWithValues: pieces.map { ($0.value, $0.key) }),
+            "merges": [[String]](),
+        ]
+        if let byteFallback {
+            model["byte_fallback"] = byteFallback
+        }
+
+        var tokenizerData: [String: Any] = [
+            "model": model,
+            "added_tokens": addedTokens.map {
+                [
+                    "id": $0.id,
+                    "content": $0.content,
+                    "single_word": false,
+                    "lstrip": false,
+                    "rstrip": false,
+                    "normalized": false,
+                    "special": $0.special,
+                ] as [String: Any]
+            },
+        ]
+        if let decoder {
+            tokenizerData["decoder"] = decoder
+        }
+        return try PreTrainedTokenizer(
+            tokenizerConfig: config(tokenizerConfig),
+            tokenizerData: config(tokenizerData))
+    }
+
+    private func makeDecoder(
+        _ pieces: [Int: String],
+        addedTokens: [AddedToken] = [],
+        skipSpecialTokens: Bool = false
+    ) throws -> any IncrementalTokenDecoder {
+        let tokenizer = try makeTokenizer(pieces, addedTokens: addedTokens)
+        return try #require(
+            tokenizer.makeIncrementalTokenDecoder(
+                skipSpecialTokens: skipSpecialTokens))
+    }
+
+    @Test("Emits stable ASCII and buffers an incomplete scalar run")
+    func splitUTF8() throws {
+        let emoji = Array("😀".utf8)
+        let pieces = [
+            0: encoded(Array("A".utf8) + Array(emoji.prefix(2))),
+            1: encoded(Array(emoji.dropFirst(2))),
+            2: encoded(Array("B".utf8)),
+        ]
+        var decoder = try makeDecoder(pieces)
+
+        // Existing streaming behavior delays the stable "A" while the same
+        // decoded chunk still ends in U+FFFD.
+        #expect(decoder.append(token: 0) == nil)
+        #expect(decoder.append(token: 1) == "A😀")
+        #expect(decoder.append(token: 2) == "B")
+    }
+
+    @Test("Matches complete UTF-8 at every token split")
+    func everyScalarSplit() throws {
+        for scalar in ["é", "中", "😀"] {
+            let bytes = Array(scalar.utf8)
+            for split in 1..<bytes.count {
+                let pieces = [
+                    0: encoded(Array(bytes.prefix(split))),
+                    1: encoded(Array(bytes.dropFirst(split))),
+                ]
+                var decoder = try makeDecoder(pieces)
+                #expect(decoder.append(token: 0) == nil)
+                #expect(decoder.append(token: 1) == scalar)
+            }
+        }
+    }
+
+    @Test("Copied decoder values keep independent UTF-8 state")
+    func copiedDecoderStateIsIndependent() throws {
+        let bytes = Array("😀".utf8)
+        let pieces = [
+            0: encoded(Array(bytes.prefix(2))),
+            1: encoded(Array(bytes.dropFirst(2))),
+        ]
+        var first = try makeDecoder(pieces)
+        var second = first
+
+        #expect(first.append(token: 0) == nil)
+        #expect(second.append(token: 1) == nil)
+        #expect(first.append(token: 1) == "😀")
+    }
+
+    @Test("Concatenated chunks preserve grapheme extensions across tokens")
+    func graphemeExtensionsAcrossTokens() throws {
+        for pair in [("a", "\u{0301}"), ("\r", "\n"), ("👩", "\u{200d}💻")] {
+            let pieces = [
+                0: encoded(Array(pair.0.utf8)),
+                1: encoded(Array(pair.1.utf8)),
+            ]
+            let tokenizer = try makeTokenizer(pieces)
+            var decoder = try #require(tokenizer.makeIncrementalTokenDecoder())
+            let streamed = (decoder.append(token: 0) ?? "") + (decoder.append(token: 1) ?? "")
+
+            #expect(streamed == tokenizer.decode(tokens: [0, 1]))
+        }
+    }
+
+    @Test("Emits definitively invalid UTF-8 with standard replacement behavior")
+    func invalidUTF8() throws {
+        let pieces = [
+            0: encoded([0xE2]),
+            1: encoded([0x28]),
+            2: encoded([0xA1]),
+            3: encoded([0x78]),
+        ]
+        var decoder = try makeDecoder(pieces)
+
+        #expect(decoder.append(token: 0) == nil)
+        #expect(decoder.append(token: 1) == String(decoding: [0xE2, 0x28], as: UTF8.self))
+        #expect(decoder.append(token: 2) == nil)
+        #expect(decoder.append(token: 3) == String(decoding: [0xA1, 0x78], as: UTF8.self))
+    }
+
+    @Test("Added token flushes pending bytes before its literal text")
+    func addedTokenBoundary() throws {
+        let special = "<tool_✓>"
+        let pieces = [0: encoded([0xE2]), 1: special]
+        var decoder = try makeDecoder(
+            pieces,
+            addedTokens: [AddedToken(id: 1, content: special, special: false)])
+
+        #expect(decoder.append(token: 0) == nil)
+        #expect(
+            decoder.append(token: 1)
+                == String(decoding: [0xE2], as: UTF8.self) + special)
+    }
+
+    @Test("Skipped special token does not split a UTF-8 scalar")
+    func skippedSpecialToken() throws {
+        let euro = Array("€".utf8)
+        let special = "<eos>"
+        let pieces = [
+            0: encoded([euro[0]]),
+            1: special,
+            2: encoded(Array(euro.dropFirst())),
+        ]
+        var decoder = try makeDecoder(
+            pieces,
+            addedTokens: [AddedToken(id: 1, content: special, special: true)],
+            skipSpecialTokens: true)
+
+        #expect(decoder.append(token: 0) == nil)
+        #expect(decoder.append(token: 1) == nil)
+        #expect(decoder.append(token: 2) == "€")
+    }
+
+    @Test("Unknown token ID is ignored without flushing pending bytes")
+    func unknownTokenID() throws {
+        let euro = Array("€".utf8)
+        let pieces = [
+            0: encoded([euro[0]]),
+            2: encoded(Array(euro.dropFirst())),
+        ]
+        var decoder = try makeDecoder(pieces)
+
+        #expect(decoder.append(token: 0) == nil)
+        #expect(decoder.append(token: 1) == nil)
+        #expect(decoder.append(token: 2) == "€")
+    }
+
+    @Test("Added token ending in a literal replacement character stays withheld")
+    func addedTokenEndingInReplacementCharacter() throws {
+        let literal = "<literal>\u{fffd}"
+        let pieces = [
+            0: encoded(Array("A".utf8)),
+            1: literal,
+            2: encoded(Array("B".utf8)),
+        ]
+        var decoder = try makeDecoder(
+            pieces,
+            addedTokens: [AddedToken(id: 1, content: literal, special: false)])
+
+        #expect(decoder.append(token: 0) == "A")
+        #expect(decoder.append(token: 1) == nil)
+        #expect(decoder.append(token: -1) == nil)
+        #expect(decoder.append(token: 2) == literal + "B")
+    }
+
+    @Test("Ignored IDs without pending replacement text emit an empty chunk")
+    func ignoredIDWithoutPendingText() throws {
+        var decoder = try makeDecoder([0: encoded(Array("A".utf8))])
+
+        #expect(decoder.append(token: -1) == "")
+        #expect(decoder.append(token: 1) == "")
+    }
+
+    @Test("Factory is fail-closed outside the certified configuration")
+    func factoryGuards() throws {
+        let pieces = [0: encoded(Array("hello .".utf8))]
+
+        #expect(try makeTokenizer(pieces).makeIncrementalTokenDecoder() != nil)
+        #expect(
+            try makeTokenizer(pieces, cleanup: true).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(pieces, cleanup: nil).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(pieces, byteFallback: true).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(pieces, byteFallback: nil).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(
+                pieces,
+                decoder: [
+                    "type": "Sequence",
+                    "decoders": [["type": "ByteLevel"]],
+                ]).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(pieces, decoder: ["type": "ByteFallback"])
+                .makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer(pieces, decoder: nil).makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer([-1: encoded(Array("negative".utf8))])
+                .makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer([999_999: encoded(Array("sparse".utf8))])
+                .makeIncrementalTokenDecoder() == nil)
+        #expect(
+            try makeTokenizer([1_000_001: encoded(Array("oversized".utf8))])
+                .makeIncrementalTokenDecoder() == nil)
+    }
+
+    @Test("Cleanup-disabled output stays byte-exact")
+    func cleanupDisabled() throws {
+        let text = "Hello ."
+        let tokenizer = try makeTokenizer([0: encoded(Array(text.utf8))])
+        var decoder = try #require(tokenizer.makeIncrementalTokenDecoder())
+
+        #expect(decoder.append(token: 0) == text)
+        #expect(tokenizer.decode(tokens: [0]) == text)
+    }
+}
