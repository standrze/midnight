+extension PreTrainedTokenizer: IncrementalTokenDecoderProviding {
+    public func makeIncrementalTokenDecoder(
+        skipSpecialTokens: Bool
+    ) -> (any IncrementalTokenDecoder)? {
+        // Cleanup and decoder sequences may rewrite earlier text. Restrict the
+        // capability to the append-safe configuration implemented above.
+        guard let incrementalByteLevelDecodingTable else { return nil }
+        let skippedTokenIDs = skipSpecialTokens ? Set(specialTokens.values) : []
+        return ByteLevelIncrementalTokenDecoder(
+            table: incrementalByteLevelDecodingTable,
+            skippedTokenIDs: skippedTokenIDs)
+    }
+}
