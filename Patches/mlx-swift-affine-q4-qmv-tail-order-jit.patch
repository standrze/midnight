diff --git a/Source/Cmlx/mlx-generated/metal/quantized.h b/Source/Cmlx/mlx-generated/metal/quantized.h
--- a/Source/Cmlx/mlx-generated/metal/quantized.h
+++ b/Source/Cmlx/mlx-generated/metal/quantized.h
@@ -771,10 +771,12 @@
     uint3 tid [[threadgroup_position_in_grid]],
     uint simd_gid [[simdgroup_index_in_threadgroup]],
     uint simd_lid [[thread_index_in_simdgroup]]) {
-  // The opt-in tail specialization is restricted to complete affine Q4/G64
-  // groups. Every participating lane reads exactly sixteen valid weights.
-  static_assert(!has_tail || (bits == 4 && group_size == 64));
-  constexpr int packs_per_thread = bits == 2 ? 1 : 2;
+  // The opt-in tail specialization keeps generic QMV's eight-value lanes
+  // and accumulation order. Complete Q4/G64 groups need no partial lane.
+  static_assert(
+      !has_tail ||
+      (bits == 4 && group_size == 64 && results_per_simdgroup == 4));
+  constexpr int packs_per_thread = (bits == 2 || has_tail) ? 1 : 2;
   constexpr int num_simdgroups = 2;
   constexpr int pack_factor = get_pack_factor<bits, 32>();
   constexpr int bytes_per_pack = get_bytes_per_pack<bits, 32>();
@@ -801,10 +803,11 @@
   x += tid.x * in_vec_size + simd_lid * values_per_thread;
   y += tid.x * out_vec_size + out_row;
 
-  const int full_size = has_tail
-      ? in_vec_size - (in_vec_size % block_size)
-      : in_vec_size;
-  for (int k = 0; k < full_size; k += block_size) {
+  // Retain generic QMV's separate final tile even when all 32 lanes are
+  // active (for example K=2816). Only the guarded addressing is simplified.
+  const int full_size = has_tail ? in_vec_size - block_size : in_vec_size;
+  int k = 0;
+  for (; k < full_size; k += block_size) {
     U sum = load_vector<T, U, values_per_thread, bits>(x, x_thread);
 
     for (int row = 0; row < results_per_simdgroup; row++) {
@@ -824,15 +827,17 @@
   }
 
   if constexpr (has_tail) {
-    const int remaining = in_vec_size - full_size;
+    const int remaining = in_vec_size - k;
     if (simd_lid * values_per_thread < remaining) {
       U sum = load_vector<T, U, values_per_thread, bits>(x, x_thread);
       for (int row = 0; row < results_per_simdgroup; row++) {
         auto wl = (const device uint8_t*)(ws + row * in_vec_size_w);
         const device T* sl = scales + row * in_vec_size_g;
         const device T* bl = biases + row * in_vec_size_g;
+        U s = sl[0];
+        U b = bl[0];
         result[row] +=
-            qdot<U, values_per_thread, bits>(wl, x_thread, sl[0], bl[0], sum);
+            qdot<U, values_per_thread, bits>(wl, x_thread, s, b, sum);
       }
     }
   }
